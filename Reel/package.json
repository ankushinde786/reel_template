{
  "name": "coding-archives-reel-kit",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Vertical 9:16 coding reels: one engine for methods, concepts, comparisons, tips, long-code walkthroughs, flowcharts and Linux terminals. Write one build.mjs per topic; all look/sound settings live in reel.config.json.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "bash setup.sh",
    "build": "node build.mjs",
    "build:render": "node build.mjs --render",
    "thumbs": "node build.mjs --voice off --thumb all",
    "voices": "node build.mjs --list-voices",
    "example:tuples": "node examples/tuples.build.mjs",
    "frame": "node tools/frame.mjs",
    "check": "cd out/list-methods && npx hyperframes check",
    "render:hf": "cd out/list-methods && npx hyperframes render",
    "example:concept": "node examples/concept.build.mjs",
    "example:compare": "node examples/compare.build.mjs",
    "example:terminal": "node examples/terminal.build.mjs",
    "example:walkthrough": "node examples/walkthrough.build.mjs",
    "example:flowchart": "node examples/flowchart.build.mjs",
    "example:javascript": "node examples/javascript.build.mjs"
  }
}
